{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adfmis-dev2"
		},
		"AzureSqlDatabase1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'AzureSqlDatabase1'"
		},
		"LS_ADLSGen2_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'LS_ADLSGen2'"
		},
		"SqlServerDev_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'SqlServerDev'"
		},
		"SqlServerProd_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'SqlServerProd'"
		},
		"AzureSqlDatabase1_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "misdevsqldb.database.windows.net"
		},
		"AzureSqlDatabase1_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "mis_dev"
		},
		"AzureSqlDatabase1_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "misadminuser"
		},
		"LS_ADLSGen2_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://adlsgen2misdev2.dfs.core.windows.net/"
		},
		"SHIR-Shared_properties_typeProperties_linkedInfo_resourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/4a3f0684-9e0a-4093-9e85-fc8d68a929d3/resourcegroups/RG_MIS_DEV/providers/Microsoft.DataFactory/factories/adfmis-dev/integrationruntimes/MIS-SHIR"
		},
		"AzureDataLakeStoragePvtEndPoint-Dev_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/4a3f0684-9e0a-4093-9e85-fc8d68a929d3/resourceGroups/RG_MIS_DEV2/providers/Microsoft.Storage/storageAccounts/adlsgen2misdev2"
		},
		"AzureDataLakeStoragePvtEndPoint-Dev_properties_groupId": {
			"type": "string",
			"defaultValue": "dfs"
		},
		"AzureDataLakeStoragePvtEndPoint-Dev_properties_fqdns": {
			"type": "array",
			"defaultValue": [
				"adlsgen2misdev2.dfs.core.windows.net"
			]
		},
		"AzurePostgreSQLPvtEndPoint-Dev2_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/4a3f0684-9e0a-4093-9e85-fc8d68a929d3/resourceGroups/RG_MIS_DEV2/providers/Microsoft.DBforPostgreSQL/servers/misdev2postgresdb"
		},
		"AzurePostgreSQLPvtEndPoint-Dev2_properties_groupId": {
			"type": "string",
			"defaultValue": "postgresqlServer"
		},
		"AzurePostgreSQLPvtEndPoint-Dev2_properties_fqdns": {
			"type": "array",
			"defaultValue": [
				"misdev2postgresdb.postgres.database.azure.com"
			]
		},
		"AzurePostgreSqlPvtEndPoint-Dev_properties_privateLinkResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/4a3f0684-9e0a-4093-9e85-fc8d68a929d3/resourceGroups/RG_MIS_DEV/providers/Microsoft.DBforPostgreSQL/servers/misdevpostgresdb"
		},
		"AzurePostgreSqlPvtEndPoint-Dev_properties_groupId": {
			"type": "string",
			"defaultValue": "postgresqlServer"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adfmis-dev2_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"AzureSqlDatabase1_password": {
						"value": "[parameters('AzureSqlDatabase1_password')]"
					},
					"LS_ADLSGen2_accountKey": {
						"value": "[parameters('LS_ADLSGen2_accountKey')]"
					},
					"SqlServerDev_connectionString": {
						"value": "[parameters('SqlServerDev_connectionString')]"
					},
					"SqlServerProd_connectionString": {
						"value": "[parameters('SqlServerProd_connectionString')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_server": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_server')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_database": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_database')]"
					},
					"AzureSqlDatabase1_properties_typeProperties_userName": {
						"value": "[parameters('AzureSqlDatabase1_properties_typeProperties_userName')]"
					},
					"LS_ADLSGen2_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLSGen2_properties_typeProperties_url')]"
					},
					"SHIR-Shared_properties_typeProperties_linkedInfo_resourceId": {
						"value": "[parameters('SHIR-Shared_properties_typeProperties_linkedInfo_resourceId')]"
					},
					"AzureDataLakeStoragePvtEndPoint-Dev_properties_privateLinkResourceId": {
						"value": "[parameters('AzureDataLakeStoragePvtEndPoint-Dev_properties_privateLinkResourceId')]"
					},
					"AzureDataLakeStoragePvtEndPoint-Dev_properties_groupId": {
						"value": "[parameters('AzureDataLakeStoragePvtEndPoint-Dev_properties_groupId')]"
					},
					"AzureDataLakeStoragePvtEndPoint-Dev_properties_fqdns": {
						"value": "[parameters('AzureDataLakeStoragePvtEndPoint-Dev_properties_fqdns')]"
					},
					"AzurePostgreSQLPvtEndPoint-Dev2_properties_privateLinkResourceId": {
						"value": "[parameters('AzurePostgreSQLPvtEndPoint-Dev2_properties_privateLinkResourceId')]"
					},
					"AzurePostgreSQLPvtEndPoint-Dev2_properties_groupId": {
						"value": "[parameters('AzurePostgreSQLPvtEndPoint-Dev2_properties_groupId')]"
					},
					"AzurePostgreSQLPvtEndPoint-Dev2_properties_fqdns": {
						"value": "[parameters('AzurePostgreSQLPvtEndPoint-Dev2_properties_fqdns')]"
					},
					"AzurePostgreSqlPvtEndPoint-Dev_properties_privateLinkResourceId": {
						"value": "[parameters('AzurePostgreSqlPvtEndPoint-Dev_properties_privateLinkResourceId')]"
					},
					"AzurePostgreSqlPvtEndPoint-Dev_properties_groupId": {
						"value": "[parameters('AzurePostgreSqlPvtEndPoint-Dev_properties_groupId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}